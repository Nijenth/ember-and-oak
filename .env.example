# Copy to .env for local overrides.
# On Cloudflare: PUBLIC_* values and SITE_URL are BUILD variables
#   (Worker → Settings → Build → Build variables).
# The three GitHub secrets further down are RUNTIME secrets
#   (Worker → Settings → Variables and Secrets, type "Secret"; locally, put them in .dev.vars).

# Your live address, used for the sitemap, canonical URLs and link previews.
SITE_URL=https://www.emberandoak.coffee

# ── Admin panel storage: set ONE of these (leave both empty for local-only editing) ──

# Option A (recommended for café staff): Keystatic Cloud. Staff sign in with email.
# Value comes from your project's settings page at keystatic.cloud, as "team/project".
PUBLIC_KEYSTATIC_CLOUD_PROJECT=

# Option B: GitHub. Each editor needs a GitHub account with access to the repo.
# PUBLIC_KEYSTATIC_GITHUB_REPO=your-github-name/ember-and-oak
# The admin will walk you through creating a GitHub App and fill these in (runtime secrets):
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=
# PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
