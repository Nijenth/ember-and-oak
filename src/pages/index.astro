---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Ticker from '../components/Ticker.astro';
import Beans from '../components/Beans.astro';
import Menu from '../components/Menu.astro';
import Bakery from '../components/Bakery.astro';
import Visit from '../components/Visit.astro';
import Footer from '../components/Footer.astro';
import Cart from '../components/Cart.astro';
import { loadSite } from '../lib/content';

const site = await loadSite();
const { settings: s, page, ordering } = site;
const links = [
  { href: '#beans', label: 'Beans' },
  { href: '#menu', label: 'Menu' },
  ...(site.bakery.length ? [{ href: '#bakery', label: 'Bakery' }] : []),
  { href: '#visit', label: 'Visit' },
];
---

<Base site={site}>
  <Header name={s.name} themeKey={site.themeKey} showSwitcher={s.showThemeSwitcher} showCart={ordering.enabled} links={links} />

  <canvas id="stage" aria-hidden="true"></canvas>

  <main id="main">
    <Hero eyebrow={page.hero.eyebrow} title={page.hero.title} text={page.hero.text} stats={[...page.stats]} />
    <Ticker items={[...page.ticker]} />
    <Beans eyebrow={page.beans.eyebrow} title={page.beans.title} text={page.beans.text} origins={site.origins} steps={[...page.steps]} />
    <Menu
      eyebrow={page.menu.eyebrow}
      title={page.menu.title}
      note={page.menu.note}
      drinks={site.drinks}
      categories={site.categories}
      startDrink={site.startDrink}
      ordering={ordering.enabled}
      formatPrice={site.formatPrice}
    />
    <Bakery
      eyebrow={page.bakery.eyebrow}
      title={page.bakery.title}
      text={page.bakery.text}
      items={site.bakery}
      categories={site.bakeryCategories}
      ordering={ordering.enabled}
      formatPrice={site.formatPrice}
    />
    <Visit
      eyebrow={page.visit.eyebrow}
      title={page.visit.title}
      addressLines={site.addressLines}
      mapsUrl={site.mapsUrl}
      phone={s.phone}
      hours={site.hours}
      note={site.hoursNote}
      timeZone={s.timeZone}
    />
  </main>

  <Footer name={s.name} instagram={s.instagram} email={s.email} />

  {ordering.enabled && (
    <Cart
      cafeName={s.name}
      items={site.cartItems}
      whatsapp={ordering.whatsapp}
      leadMinutes={ordering.leadMinutes}
      note={ordering.note}
      deliveryUrl={ordering.deliveryUrl}
      currency={s.currency}
      locale={s.locale}
      timeZone={s.timeZone}
      hours={site.hours}
    />
  )}

  <script>
    import '../scripts/site';
    import '../scripts/cart';
  </script>
</Base>
