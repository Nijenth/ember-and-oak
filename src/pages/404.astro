---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { loadSite } from '../lib/content';

const site = await loadSite();
const { settings: s } = site;
---

<Base site={site} title={`Page not found · ${s.name}`} noindex>
  <Header name={s.name} themeKey={site.themeKey} showSwitcher={false} />
  <main id="main" class="wrap notfound">
    <span class="eyebrow">404</span>
    <h1>Spilled it.</h1>
    <p class="lede" style="margin-inline:auto">That page doesn't exist, or it moved. The coffee's still on, though.</p>
    <a class="btn" href="/">Back to the homepage</a>
  </main>
  <Footer name={s.name} instagram={s.instagram} email={s.email} showBigName={false} />
</Base>
