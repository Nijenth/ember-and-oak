---
/**
 * The order drawer: items, quantities, total, pickup details, and the
 * "Send order on WhatsApp" button. Filled in by src/scripts/cart.ts.
 */
import type { CartItem, DayHours } from '../lib/content';

interface Props {
  cafeName: string;
  items: CartItem[];
  whatsapp: string;
  leadMinutes: number;
  note: string;
  deliveryUrl?: string | null;
  currency: string;
  locale: string;
  timeZone: string;
  hours: DayHours[];
}
const { cafeName, items, whatsapp, leadMinutes, note, deliveryUrl, currency, locale, timeZone, hours } = Astro.props;
const data = {
  cafe: cafeName,
  items: Object.fromEntries(items.map((i) => [i.id, { name: i.name, price: i.price }])),
  whatsapp,
  lead: leadMinutes,
  currency,
  locale,
  tz: timeZone,
  hours,
};
---
<button class="order-bar" type="button" id="orderBar" aria-haspopup="dialog" aria-controls="cart" hidden>
  <span class="order-bar-count" id="orderBarCount">0 items</span>
  <span class="order-bar-label">View order</span>
  <span class="order-bar-total" id="orderBarTotal"></span>
</button>

<dialog class="cart" id="cart" aria-labelledby="cart-title">
  <div class="cart-in">
    <header class="cart-head">
      <h2 id="cart-title">Your order</h2>
      <span class="eyebrow">Pickup</span>
      <button type="button" class="cart-close" id="cartClose" aria-label="Close">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
      </button>
    </header>

    <div class="cart-view" id="cartView">
      <p class="cart-empty" id="cartEmpty">Nothing here yet. Add a drink or something from the bakery.</p>
      <ul class="cart-list" id="cartList"></ul>

      <div class="cart-sum" id="cartSum" hidden>
        <span>Total</span>
        <strong id="cartTotal"></strong>
      </div>

      <form class="checkout" id="checkout" hidden novalidate>
        <label class="field">
          <span>Your name</span>
          <input type="text" name="name" id="coName" autocomplete="name" required maxlength="60" />
          <small class="field-err" id="coNameErr" hidden>Please add your name so we know whose order it is.</small>
        </label>
        <label class="field">
          <span>Pickup time</span>
          <select name="pickup" id="coPickup" required></select>
          <small class="field-err" id="coPickupErr" hidden>We're not taking pickup orders in the next few days.</small>
        </label>
        <label class="field">
          <span>Note <em>(optional)</em></span>
          <textarea name="note" id="coNote" rows="2" maxlength="300" placeholder="Oat milk, extra hot, cut the muffin in half…"></textarea>
        </label>

        {note && <p class="cart-note">{note}</p>}

        {whatsapp ? (
          <button class="btn btn-wa" type="submit" id="coSend">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.4.1-.2 0-.3 0-.5l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.4.8 3.2.7a2.8 2.8 0 0 0 1.9-1.3 2.3 2.3 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3Z"></path></svg>
            Send order on WhatsApp
          </button>
        ) : (
          <p class="cart-off">Online ordering isn't connected yet. Add the café's WhatsApp number in the admin (Café details → Online ordering).</p>
        )}
        {deliveryUrl && <p class="cart-delivery">Want delivery? <a href={deliveryUrl} target="_blank" rel="noopener">Order on our delivery partner</a></p>}
      </form>
    </div>

    <div class="cart-sent" id="cartSent" hidden>
      <div class="cart-sent-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M5 12.5l4.2 4.2L19 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </div>
      <h3>Almost done</h3>
      <p>WhatsApp has opened with your order. <strong>Press Send in WhatsApp</strong> to place it. We'll reply there to confirm.</p>
      <p class="cart-sent-small">WhatsApp didn't open? <a href="#" id="coRetry" target="_blank" rel="noopener">Tap here to try again</a>.</p>
      <div class="cart-sent-actions">
        <button class="btn" type="button" id="coDone">Done, start a new order</button>
        <button class="btn btn-ghost" type="button" id="coBack">Back to my order</button>
      </div>
    </div>
  </div>
</dialog>

<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script type="application/json" id="cart-data" set:html={JSON.stringify(data)}></script>
