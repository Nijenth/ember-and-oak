---
import Logo from './Logo.astro';
import { THEMES, type ThemeKey } from '../data/themes';

interface Props { name: string; themeKey: ThemeKey; showSwitcher: boolean; showCart?: boolean; links?: { href: string; label: string }[] }
const { name, themeKey, showSwitcher, showCart = false, links = [{ href: '/#beans', label: 'Beans' }, { href: '/#menu', label: 'Menu' }, { href: '/#visit', label: 'Visit' }] } = Astro.props;
const themes = Object.entries(THEMES) as [ThemeKey, (typeof THEMES)[ThemeKey]][];
---
<header class="head">
  <div class="wrap head-in">
    <a class="logo" href="/" aria-label={`${name}, home`}>
      <Logo />
      <span class="logo-text">{name}</span>
    </a>
    <nav class="nav" aria-label="Main">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    {showSwitcher && (
      <>
        <span class="theme-name" id="themeName" aria-live="polite">{THEMES[themeKey].label}</span>
        <fieldset class="swatches" id="swatches">
          <legend class="sr-only">Colour theme</legend>
          {themes.map(([k, t]) => (
            <label class="sw" title={t.label}>
              <input type="radio" name="theme" value={k} checked={k === themeKey} data-label={t.label} />
              <span style={`--a:${t.c.paper};--b:${t.d3.cup}`} aria-hidden="true"></span>
              <span class="sr-only">{t.label}</span>
            </label>
          ))}
        </fieldset>
      </>
    )}
    {showCart && (
      <button class="cart-btn" type="button" id="cartBtn" aria-haspopup="dialog" aria-controls="cart" aria-label="Your order, 0 items">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14l-1.2 11.1a2 2 0 0 1-2 1.9H8.2a2 2 0 0 1-2-1.9Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path><path d="M9 10V7a3 3 0 0 1 6 0v3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
        <span class="cart-count" id="cartCount" hidden>0</span>
      </button>
    )}
  </div>
</header>
